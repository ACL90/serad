  if (lang == "en") {
    comparaison(
      x1, x2,
      hausse_defaut = "above",
      egalite_defaut = "at the same level as",
      baisse_defaut = "below",
      seuil = 0
    )
  } else {
    comparaison(
      x1, x2,
      hausse_defaut = "au-dessus de",
      egalite_defaut = "au même niveau que",
      baisse_defaut = "en dessous de",
      seuil = 0
    )
  }
}

formuler_position(104, 100)

